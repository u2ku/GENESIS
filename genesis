IDENTITY_FILE = ROOT / "identity.g"
IDENTITY_MD = DOCS / "IDENTITY.md"
BIN = ROOT / "bin"

if str(SRC) not in sys.path:
    sys.path.insert(0, str(SRC))

# The system constant. If this string changes, the system has changed
# identity — genesis check refuses to call that a healthy system.
PINNED_ID = "∩(■, ⊡) = I"

PROBES = {
    "claude-mlx": ("http://127.0.0.1:8082/health", "mlx-vlm"),
    "claude-gemma4": ("http://127.0.0.1:11434/api/tags", "ollama"),
}

