    if not argv:
        for name, f in sorted(known.items()):
            print(f"  genesis handoff {name}    {docs / f}")
        return 0
    name = argv[0].lower()
    if name in ("list", "?"):
        for n, f in sorted(known.items()):
            print(f"  genesis handoff {n}    {docs / f}")
        return 0
    f = docs / known.get(name, f"HANDOFF-{name.upper()}.md")
    if not f.exists():
        die(f"no handoff for {name} in {docs}")
    print(f.read_text(encoding="utf-8"))
    return 0


