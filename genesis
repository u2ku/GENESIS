# Plain words for the same operations. Nobody should need the internal names.
PLAIN = {
    "identity": "id", "who": "id", "what": "id", "i": "i",
    "plan": "prediction", "sequence": "prediction", "arc": "prediction",
    "vocabulary": "symbols", "words": "symbols", "alphabet": "symbols",
    "pattern": "numergram", "compare": "shield", "now": "stamp",
    "moment": "stamp", "meaning": "algebra", "safety": "guardrail",
    "check": "check", "health": "check", "readings": "singularity",
    "position": "singularity", "resonance": "resonance", "aeon": "aeon",
}


def main(argv):
    if not argv:
        return cmd_summary()
    if argv[0] in ("help", "?", "--h"):
        return cmd_help()
    if argv[0] in ("-h", "--help"):
        print(USAGE)
        return 0
    if argv[0] in ("chat", "talk"):
        try:
            import harness
        except Exception as exc:
            die(f"cannot load the harness: {exc}")
        backend = "mlx"
        if argv[1:2] and argv[1] in harness.BACKENDS:
            backend = argv[1]
        return harness.chat(backend)
    if argv[0] == "--card":
        print((ROOT / "card.md").read_text(encoding="utf-8"))
        return 0
    if argv[0] == "--tools":
        import harness
        for n, d, _, _ in harness.TOOLS:
            print(f"  {n:<22} {d}")
        return 0
    cmd = PLAIN.get(argv[0], argv[0])
    if cmd not in SUBCOMMANDS:
        # Not an engine operation — ask Genesis.
        try:
            import harness
        except Exception as exc:
            die(f"cannot load the harness: {exc}")
        ask = " ".join(argv)
        low = ask.strip().lower()
        seed = SEEDS.get(low)
        if seed is None:
            for phrase, text in SEEDS.items():
                if phrase in low:
                    seed = text
                    break
        if seed is not None and low not in SEEDS:
            seed = seed + "\n\nSpecifically asked: " + ask
        try:
            print(harness.talk(seed if seed else ask))
        except RuntimeError as exc:
            die(str(exc))
        return 0
    rest = argv[1:]
    if cmd == "handoff":
        return cmd_handoff(rest)
    if cmd == "convergence":
        return cmd_convergence(rest)
    if cmd == "playlist":
        return cmd_playlist(rest)
    if cmd == "id":
        return cmd_id(rest)
    if cmd == "i":
        blocks = load_blocks()
        print(blocks.get("i", ""))
        print()
        print(blocks.get("not-i", ""))
        return 0
    if cmd == "symbols":
        return cmd_symbols(rest)
    if cmd == "prediction":
        blocks = load_blocks()
        if "--readings" in rest:
            print(blocks.get("disaster", ""))
            print()
            print(blocks.get("beauty", ""))
            return 0
        return cmd_prediction(rest)
    if cmd == "singularity":
        return cmd_singularity(rest)
    if cmd == "stamp":
        return cmd_stamp(rest)
    if cmd == "aeon":
        return cmd_aeon(rest)
    if cmd == "resonance":
        return cmd_resonance(rest)
    if cmd == "numergram":
        return cmd_numergram(rest)
    if cmd == "algebra":
        return cmd_algebra(rest)
    if cmd == "guardrail":
        return cmd_guardrail(rest)
    if cmd == "shield":
        return cmd_shield(rest)
    if cmd == "check":
        return cmd_check("--probe" in rest)
    if cmd == "summary":
        return cmd_summary()
    die(f"unknown command: {cmd}  (try: genesis --help)")
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
