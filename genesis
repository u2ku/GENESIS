# Python 3.14 gave argparse a colour of its own, and it paints its help even
# through a pipe. The house look is one accent and no more, and piped output
# is the raw payload — so argparse keeps to plain text.
_ARGPARSE_PLAIN = ({"color": False}
                   if "color" in inspect.signature(argparse.ArgumentParser).parameters
                   else {})


def _parser(name, help_text, epilog=None):
    p = argparse.ArgumentParser(
        prog=f"genesis {name}",
        description=help_text,
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=epilog,
        **_ARGPARSE_PLAIN,
    )
    return _common(p)


