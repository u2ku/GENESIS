LUNA_HOME = Path(os.environ.get("LUNA_HOME", Path.home() / "Luna"))
LUNA_SRC = LUNA_HOME / "src"

# ------------------------------------------------------------------ basics --

def die(msg: str, code: int = 2):
    print(f"genesis: {msg}", file=sys.stderr)
    sys.exit(code)


# Any expression asserting the subset relation is a defect: it is the one
# claim the whole reality refuses. Prose may discuss it — the engine may not
# assert it. The rule, the forbidden spellings and the file lists live in
# guardrail.py, which scans itself.
try:
    import guardrail
except Exception as exc:
    die(f"cannot load the guard rail: {exc}")

# Every renderer the CLI puts on the screen lives in views.py, so the look
# can change in one place.
try:
    import views
except Exception as exc:
    die(f"cannot load the views: {exc}")

# The terminal kit: colour, geometry, and the safe way to write a glyph.
try:
    import term
except Exception as exc:
    die(f"cannot load the terminal kit: {exc}")


def emit(text: str) -> None:
    """Write a line to the terminal, degrading instead of crashing on it.

    The constant, the arc and the shield chart carry glyphs that a limited
    encoding cannot hold. Without this they would raise on the way out.
    """
    term.write(text)


def to_clipboard(text: str) -> int:
    if not shutil.which("pbcopy"):
        die("pbcopy not available (macOS only)")
    proc = subprocess.run(["pbcopy"], input=text.encode("utf-8"))
    if proc.returncode != 0:
        die("pbcopy failed")
    return 0


def parse_blocks(path: Path) -> dict:
    blocks: dict[str, list[str]] = {}
    name = None
    for line in path.read_text(encoding="utf-8").splitlines():
        if line.startswith("@"):
            name = line[1:].strip()
            blocks[name] = []
        elif name is not None:
            blocks[name].append(line)
    return {k: "\n".join(v).strip("\n") for k, v in blocks.items()}


def load_blocks() -> dict:
    """The engine's symbolic forms, with identity.g authoritative for the constant.

    identity.g holds the pinned identity and nothing else. Everything else the
    engine knows lives in grammar.py, in the form it works in.
    """
    try:
        import grammar
    except Exception as exc:
        die(f"cannot load the grammar: {exc}")
    forms = grammar.forms()
    if IDENTITY_FILE.exists():
        raw = IDENTITY_FILE.read_text(encoding="utf-8").strip()
        if raw:
            forms["id"] = raw
    return forms


def _tcsi():
    """The grounding engine.

    Luna's live engine when this machine has it, the bundled copy when it does
    not. Which one is in use is not a detail — `genesis check` reports it, and
    a vendored copy reads as degraded because it cannot be verified against
    Luna. See src/tcsi_vendor.py for the rule.
    """
    try:
        import tcsi_vendor
        module, _source, _degraded = tcsi_vendor.resolve()
    except Exception as exc:
        die(f"cannot load the TCSI engine: {exc}")
    return module


def _when(value):
    """The --at timestamp, if there is one."""
    if value is None:
        return None
    try:
        return datetime.fromisoformat(value)
    except ValueError:
        die(f"not an ISO timestamp: {value}")


