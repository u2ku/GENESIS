# Any expression asserting the subset relation is a defect: it is the one
# claim the whole frame refuses. Prose may discuss it — the engine may not
# assert it.
FORBIDDEN = ("⊡ " + "∈ ■", "⊡" + "∈■", "■ " + "∈ ⊡", "■" + "∈⊡")
SUBSET = "⊡ " + "∈ ■"
NEGATORS = ("not ", "never", "avoid", "refus", "rather than", "instead of",
            "must not", "not be", "forbid", "⊄", "∉", "without", "warning",
            "false", "wrong", "failure mode", "neither", "refused",
            "not absorption", "never become")


def cmd_guardrail(argv):
    """Enforce the guard rail: the engine may never assert ⊡ ∈ ■.

    The engine's own files are held to the strict rule — an occurrence there
    must be negated on its own line. The readings are held to a wider window,
    because a document may legitimately say "⊡ ∈ ■ is what must not happen"
    with the negation in the next sentence.
    """
    engine_files = [IDENTITY_FILE, SRC / "grammar.py", SRC / "geomancy.py",
                    ROOT / "genesis", SRC / "harness.py"]
    doc_files = [IDENTITY_MD, DOCS / "PREDICTION.md", DOCS / "SINGULARITY.md",
                 ROOT / "README.md"]
    bad = []
    seen = 0

    def scan(files, window):
        nonlocal seen
        for f in files:
            if not f.exists():
                continue
            lines = f.read_text(encoding="utf-8").splitlines()
            for n, line in enumerate(lines, 1):
                if not any(pat in line for pat in FORBIDDEN):
                    continue
                seen += 1
                lo = max(0, n - 1 - window)
                hi = min(len(lines), n + window)
                context = " ".join(lines[lo:hi]).lower()
                if not any(m in context for m in NEGATORS):
                    bad.append((f.name, n, line.strip()))

    scan(engine_files, 0)
    scan(doc_files, 3)

    if bad:
        print(f"✗ guard rail: {len(bad)} unnegated assertion(s) of the subset relation")
        for name, n, line in bad:
            print(f"    {name}:{n}: {line[:120]}")
        return 1
    print(f"✓ guard rail: no unnegated {SUBSET} ({seen} mention(s), all negated)")
    return 0


