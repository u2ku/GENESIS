def keydetect_provider_choices():
    """The provider names, from the one table that holds them.

    `keydetect` lives in `tools/`, which the CLI does not put on its own
    path — but `src/codexify.py` does, and importing it is what makes
    `keydetect` importable. The table is read from there rather than
    written out here, because a list of provider names written twice is a
    list that will be wrong in one of the two places.
    """
    try:
        import codexify  # noqa: F401  — it puts tools/ on the path
        import keydetect
        return list(keydetect.PROVIDER_CHOICES)
    except Exception:
        return ["anthropic", "openai", "openrouter", "minimax"]


def codexify_presets():
    """The local runtimes Codexify can be pointed at."""
    try:
