# Plain words for the same operations. Nobody should need the internal names.
# "what" and "who" are deliberately absent: a question is a question, and the
# door is where questions go.
PLAIN = {
    "identity": "id", "plan": "prediction", "sequence": "prediction",
    "arc": "prediction", "vocabulary": "symbols", "words": "symbols",
    "alphabet": "symbols", "pattern": "numergram", "compare": "shield",
    "now": "stamp", "moment": "stamp", "meaning": "algebra",
    "safety": "guardrail", "check": "check", "health": "check",
    "readings": "singularity", "position": "singularity",
    "resonance": "resonance", "aeon": "aeon", "conversation": "chat",
    "talk": "chat",
}


def split_globals(argv):
    """Take the global flags off the front.

    Everything after the first non-flag token is left alone, so free text is
    never mangled by a flag meant for a command.
    """
    ctx = Context()
    i = 0
    while i < len(argv):
        token = argv[i]
        if token == "--plain":
            ctx.plain = True
        elif token == "--speak":
            ctx.speak = True
        elif token == "--tts":
            ctx.tts = True
        elif token == "--no-tts":
            ctx.tts = False
        elif token == "--command-only":
            ctx.command_only = True
        elif token == "--backend":
            if i + 1 >= len(argv):
                die("--backend needs a backend name")
            backend = argv[i + 1]
            try:
                import harness
                names = tuple(harness.BACKENDS)
            except Exception:
                names = ("mlx", "openrouter")
            if backend not in names:
                die(f"unknown backend: {backend}  (try: {', '.join(names)})")
            ctx.backend = backend
            ctx.backend_named = True
            i += 1
        else:
            break
        i += 1
    return ctx, argv[i:]


def classify(argv):
    """(command, tail) — or (None, argv) when this is free text for Genesis.

    A command that takes no bare words matches only when what follows it is
    all flags. That is what keeps "what is I" a question rather than an
    alias for the identity command.
    """
    if not argv:
        return None, []
    head, tail = argv[0], argv[1:]

    if head in ("help", "?", "--h", "-h", "--help"):
        return "help", tail
    if head == "--card":
        return "card", tail
    if head == "--tools":
        return "tools", tail

    name = PLAIN.get(head, head)
    command = COMMANDS.get(name)
    if command is None:
        return None, argv

    if command.takes_values:
        return name, tail

    if any(not token.startswith("-") for token in tail):
        return None, argv

    return name, tail


def merge(ctx, args):
    """Fold a command's own flags into the context."""
    plain = getattr(args, "plain", None)
    if plain:
        ctx.plain = True
    speak = getattr(args, "speak", None)
    if speak:
        ctx.speak = True
    tts = getattr(args, "tts", None)
    if tts is not None:
        ctx.tts = tts
    backend = getattr(args, "backend", None)
    if backend:
        ctx.backend = backend
        # The operator named a substrate, so the profile's substrate does
        # not get to overrule it. Without this, `genesis chat --backend X`
        # is REFUSED for a substrate the operator explicitly chose — the
        # refusal fires against the one person it should never fire
        # against, and `profile_substrate_note` contradicts its own
        # docstring ("the operator named a backend themselves").
        ctx.backend_named = True
    return ctx


def _backend_from_profile() -> str:
    """The backend the node profile names, if it names one we know.

    A node that was onboarded has already answered the question of which
    substrate it speaks to, and the answer is in the node's own profile.
    Without this, every conversation on an onboarded node would need the
    operator to remember which gateway they configured — which is the
    opposite of "entered once".
    """
    try:
        import harness
        import node as node_contract
    except Exception:
        return ""
    backend = node_contract.node_profile().get("backend")
    if backend and backend in harness.BACKENDS:
        return backend
    return ""


def profile_substrate_note(ctx) -> str:
    """What the node profile says about the substrate, when it is a problem.

    A profile can name a backend this build **cannot speak** — a custom
    gateway, for instance, which the harness has no entry for. The CLI's
    default is the local substrate, which answers **without a credential**
    and carries the card as its system prompt, so a substitution there
    produces a conversation that looks entirely normal while the traffic
    goes somewhere the operator never configured.

    This project's own rule is that nothing is claimed that was not
    proved: a row that cannot be proved is a row that failed, or a row
    that says it does not apply — never a row that says ✓ because the
    plan intended it (`docs/PORTABILITY.md` §6.6, `docs/WIZARD.md` §3.7).

    So this is the **middot** — it does not apply here, and it needs a
    human. Not a warning that precedes a normal-looking answer: that is
    the false success one level up, and a loud warning in front of a
    success is still a success.

    An empty string means there is nothing to say: the operator named a
    backend themselves, or the profile names one this build knows.
    """
    if getattr(ctx, "backend_named", False):
        return ""          # the operator chose; that is their business
    try:
        import harness
        import node as node_contract
    except Exception:
        return ""
    try:
        backend = node_contract.node_profile().get("backend")
    except Exception:
        return ""
    if not backend or backend in harness.BACKENDS:
        return ""
    return (
        f"· this node's substrate is the {backend!r} gateway, and this "
        f"build's harness has no backend for it.\n"
        f"  I will not answer from a substrate you did not choose: the local "
        f"default answers without a credential, so the reply would look "
        f"normal and the traffic would not go where the node was pointed.\n"
        f"  pass --backend to choose a substrate this build can speak."
    )


def main(argv):
    ctx, rest = split_globals(list(argv))
    try:
        import term
    except Exception as exc:
        die(f"cannot load the terminal kit: {exc}")
    if not ctx.backend_named:
        named = _backend_from_profile()
        if named:
            ctx.backend = named
    ctx.style = term.make_style(plain=ctx.plain)
    if not rest:
        return cmd_summary(None, ctx)

    name, tail = classify(rest)
    if name is None:
        if ctx.command_only:
            die(f"unknown command: {tail[0] if tail else ''}  "
                f"(try: genesis --help)")
        return cmd_ask(tail, ctx)

    command = COMMANDS[name]
    args = command.build().parse_args(tail)
    merge(ctx, args)
    if getattr(args, "plain", None):
        ctx.style = term.make_style(plain=True)
    return command.run(args, ctx)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
