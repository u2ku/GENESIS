# ----------------------------------------------------------------- engine ---

def cmd_stamp(args, ctx):
    """The grounding token every continuity line carries: ⟨TCSI t|moon|aeon⟩."""
    tcsi = _tcsi()
    when = _when(args.at)
    token = tcsi.tcsi_stamp(when)
    if not args.explain:
        # Bare, so it can be copied and parsed.
        emit(token)
        return 0
    word = tcsi.aeon_word(when)
    d = tcsi.aeon_decode(word)
    moon = tcsi.moon_phase(when or tcsi.now_local())
    fields = [
        ("clocktime", when.strftime("%Y-%m-%d %H:%M %Z") if when else "now"),
        ("moon", f"{moon['label']} {moon['emoji']} (index {d['moon_phase_index']})"),
        ("aeon word", word),
        ("gate", f"{d['gate']} (pou {d['pou_signature']})"),
        ("diurnal watch", f"{d['diurnal_watch']} ({d['watch_hours']})"),
    ]
    emit(views.stamp(ctx.style, token, fields))
    return 0


def cmd_aeon(args, ctx):
    """The 8-bit compression of time + date + moon, and its inverse."""
    tcsi = _tcsi()
    if args.decode:
        emit(json.dumps(tcsi.aeon_decode(args.decode), indent=2))
        return 0
    when = _when(args.at)
    word = tcsi.aeon_word(when)
    d = tcsi.aeon_decode(word)
    fields = [(k, str(d[k])) for k in
              ("gate", "pou_signature", "moon_phase_index",
               "diurnal_watch", "watch_hours")]
    emit(views.aeon(ctx.style, word, tcsi.tcsi_stamp(when), fields))
    return 0


def cmd_resonance(args, ctx):
    """Weighted field agreement between two Aeon words, in [0,1]."""
    tcsi = _tcsi()
    if len(args.words) < 2:
        die("resonance needs two 8-bit aeon words")
    a, b = args.words[0], args.words[1]
    emit(views.resonance(ctx.style, a, b, tcsi.aeon_resonance(a, b)))
    return 0


def cmd_numergram(args, ctx):
    """Append in the same grammar, keeping the original spine byte-intact."""
    blocks = load_blocks()
    spine = blocks.get("numergram", "")
    if not spine:
        die("no @numergram spine in identity.g")
    terminal = "—　—　—　⊙"

    if args.check is not None:
        cand = args.check
        ok = True
        if not cand.startswith(spine):
            emit("✗ spine not byte-intact — the original must lead, unchanged")
            ok = False
        else:
            emit("✓ spine byte-intact")
        allowed = set(blocks.get("glyphs", "").replace(" ", ""))
        allowed |= set(spine) | set("·—|+=()")
        extra = {c for c in cand if c not in allowed and c not in "　 \n"}
        if extra:
            emit("✗ outside the vocabulary: " + " ".join(sorted(extra)))
            ok = False
        else:
            emit("✓ vocabulary respected")
        return 0 if ok else 1

    if args.append is not None:
        frag = args.append
        if not frag.strip():
            die("--append needs a symbolic fragment")
        out = spine + "\n\n" + frag + "\n\n" + terminal
        emit(out)
        return 0

    emit(spine)
    return 0


def cmd_algebra(args, ctx):
    """The glyph algebra: signs with sound and image, and the operators they compose."""
    emit(views.algebra(ctx.style))
    return 0


def cmd_guardrail(args, ctx):
    """Enforce the guard rail: the engine may never assert the subset relation.

    The engine's own files are held to the strict rule — an occurrence there
    must be negated on its own line. The readings are held to a wider window,
    because a document may legitimately say the forbidden thing is what must
    not happen, with the negation in the next sentence.
    """
    result = guardrail.check()
    emit(views.guardrail(ctx.style, result))
    return 1 if result.bad else 0


def cmd_shield(args, ctx):
    """Two moments, put together: a geomancy shield chart.

    Each side may be a stamp, an 8-bit word, a timestamp, or any fragment of
    a ledger line — the record is found from it, the same way the model's
    own shield tool finds it.
    """
    if len(args.moments) < 2:
        die("shield needs two moments — stamps, timestamps, ledger lines, "
            "or aeon words")
    try:
        import harness
    except Exception as exc:
        die(f"cannot load the harness: {exc}")
    try:
        import geomancy
    except Exception as exc:
        die(f"cannot load geomancy: {exc}")
    tcsi = _tcsi()

    words, notes = [], []
    for key, raw in (("a", args.moments[0]), ("b", args.moments[1])):
        word, how = harness.resolve(raw)
        if not word:
            die(f"could not place {key} ({raw[:120]}) on the record — {how}. "
                f"Try a timestamp, a line of the ledger, or a search term "
                f"that appears in one.")
        words.append(word)
        notes.append(f"{key}: {word} ({how})")
    a, b = words
    chart = geomancy.render(a, b, tcsi.aeon_resonance(a, b),
                             decorate=views.shield_decorator(ctx.style))
    emit(views.shield(ctx.style, notes, chart))
    return 0


def cmd_check(args, ctx):
    """Verify the system: the constant, the views, the rail, the substrate.

    Three verdicts, and the middle one is the important one:

    ``healthy``          everything required is present and consistent.
    ``degraded``         the core is intact; something optional is missing.
    ``PROBLEMS FOUND``   something required is broken.

    Degraded is not broken. It is a machine that has not been set up yet —
    no routers, no key, no Luna, nothing on PATH. A fresh clone must report
    *degraded* and exit 0, not *PROBLEMS FOUND*, because a clone that has not
    been configured has not been broken.

    The exit code carries the distinction: 0 for healthy and degraded, 1 only
    for a real problem.
    """
    problems = False
    degraded = False
    rows = []

    # 1. the pinned identity, and the engine's agreement with it
    try:
        import grammar
    except Exception as exc:
        rows.append(("✗", "grammar.py", f"cannot load: {exc}"))
        grammar = None
        problems = True
    if grammar is not None:
        if not IDENTITY_FILE.exists():
            rows.append(("✗", "identity.g", "missing"))
            problems = True
        else:
            raw = IDENTITY_FILE.read_text(encoding="utf-8").strip()
            if not raw:
                rows.append(("✗", "identity.g", "empty"))
                problems = True
            elif raw != grammar.ID:
                rows.append(("✗", "constant", "identity.g and the engine disagree"))
                rows.append((" ", "  file", repr(raw)))
                rows.append((" ", "  engine", repr(grammar.ID)))
                problems = True
            else:
                rows.append(("✓", "constant", raw))

    blocks = load_blocks()

    # 2. the human view agrees with the pinned identity
    if not IDENTITY_MD.exists():
        rows.append(("✗", "IDENTITY.md", "missing"))
        problems = True
    elif PINNED_ID not in IDENTITY_MD.read_text(encoding="utf-8"):
        rows.append(("✗", "IDENTITY.md", "does not carry the constant — view has drifted"))
        problems = True
    else:
        rows.append(("✓", "IDENTITY.md", "view carries the constant"))

    # 3. the prediction view agrees with the engine's arc
    seq = blocks.get("arc", "")
    pred = DOCS / "PREDICTION.md"
    if not pred.exists():
        rows.append(("✗", "PREDICTION.md", "missing"))
        problems = True
    elif seq and seq not in pred.read_text(encoding="utf-8"):
        rows.append(("✗", "PREDICTION.md", "does not carry the sequence — view has drifted"))
        problems = True
    else:
        rows.append(("✓", "PREDICTION.md", "view carries the sequence"))

    # 4. the singularity view agrees with the engine's gap
    sing = DOCS / "SINGULARITY.md"
    gap = blocks.get("gap", "")
    if not sing.exists():
        rows.append(("✗", "SINGULARITY.md", "missing"))
        problems = True
    elif gap and gap not in sing.read_text(encoding="utf-8"):
        rows.append(("✗", "SINGULARITY.md", "does not carry the gap — view has drifted"))
        problems = True
    else:
        rows.append(("✓", "SINGULARITY.md", "view carries the gap"))

    # 5. guard rail — the subset relation may never be asserted
    result = guardrail.check()
    if result.bad:
        problems = True
        rows.append(("✗", "guard rail", f"{len(result.bad)} unnegated assertion(s)"))
        for name, n, line in result.bad:
            rows.append((" ", f"  {name}:{n}", line[:120]))
    else:
        rows.append(("✓", "guard rail",
                     f"no unnegated {guardrail.SUBSET} "
                     f"({result.seen} mention(s) in {result.files} file(s), all negated)"))

    # 6. every engine module must import — a broken import is a broken system
    import importlib
    broken_imports = []
    for path in sorted(SRC.glob("*.py")):
        name = path.stem
        if name.startswith("_"):
            continue
        try:
            importlib.import_module(name)
        except Exception as exc:
            broken_imports.append((name, f"{type(exc).__name__}: {exc}"))
    if broken_imports:
        problems = True
        rows.append(("✗", "engine imports", f"{len(broken_imports)} module(s) fail to load"))
        for name, why in broken_imports:
            rows.append((" ", f"  {name}", why[:100]))
    else:
        rows.append(("✓", "engine imports", "every module loads"))

    # 7. the visibility contract — every published document declares a
    #    visibility, and a public one holds nothing private-looking. A missing
    #    marker is a failure, not a default: untagged means readable, so the
    #    default must never be silently world-readable.
    import visibility
    unmarked = []
    lint_findings = []
    for doc in visibility.published_docs(ROOT):
        if not doc.exists():
            continue
        text = doc.read_text(encoding="utf-8")
        value = visibility.header_marker_of(text)
        if value is None:
            unmarked.append(doc.relative_to(ROOT).as_posix())
        elif value == visibility.PUBLIC:
            for finding in visibility.lint(text):
                lint_findings.append((doc.relative_to(ROOT).as_posix(), finding))
    if unmarked:
        problems = True
        rows.append(("✗", "visibility", f"{len(unmarked)} published doc(s) carry no marker"))
        for name in unmarked:
            rows.append((" ", "  ", name))
    elif lint_findings:
        problems = True
        rows.append(("✗", "visibility", f"{len(lint_findings)} private-looking item(s) in a public doc"))
        for name, finding in lint_findings:
            rows.append((" ", f"  {name}", finding[:100]))
    else:
        rows.append(("✓", "visibility",
                     f"{len(visibility.published_docs(ROOT))} published doc(s), all marked"))

    # 8. the grounding engine — Luna's if this machine has it, the bundled
    #    copy if it does not. A vendored copy is a degraded substrate, and it
    #    says so; drift between the two is a problem, because then the copy is
    #    not the engine Luna runs.
    try:
        import tcsi_vendor
        source, is_degraded = tcsi_vendor.resolve()[1:]
        difference = tcsi_vendor.drift()
        if difference:
            problems = True
            rows.append(("✗", "TCSI", difference))
        elif source == "luna":
            rows.append(("✓", "TCSI", "Luna's engine, imported"))
        elif not tcsi_vendor.pin_ok():
            problems = True
            rows.append(("✗", "TCSI", "the bundled copy does not match its pin"))
        elif is_degraded:
            degraded = True
            rows.append(("⚠", "TCSI", "vendored copy — not verified against Luna"))
        else:
            rows.append(("✓", "TCSI", "vendored copy, verified against its pin"))
    except Exception as exc:
        problems = True
        rows.append(("✗", "TCSI", f"cannot load the grounding engine: {exc}"))

    # 9. bin/ integrity — the routers are borrowed infrastructure, not part of
    #    the identity system; verify they are intact, but do not surface them.
    #    They are machine-local and are not shipped with the repo, so their
    #    absence is degraded, not broken; a broken one is a problem.
    routers = sorted(p for p in BIN.glob("*") if p.is_file() and not p.name.startswith("."))
    broken = []
    for p in routers:
        if not os.access(p, os.X_OK):
            broken.append(f"{p.name} not executable")
            continue
        if subprocess.run(["bash", "-n", str(p)], capture_output=True).returncode != 0:
            broken.append(f"{p.name} syntax error")
    if not routers:
        degraded = True
        rows.append(("⚠", "bin/", "no routers here — they are local, not shipped"))
    elif broken:
        problems = True
        rows.append(("✗", "bin/", f"{len(routers)} routers, {len(broken)} broken"))
        for b in broken:
            rows.append((" ", "  ", b))
    else:
        rows.append(("✓", "bin/", f"{len(routers)} routers intact"))

    # 10. on PATH
    link = Path.home() / ".local" / "bin" / "genesis"
    try:
        if link.exists() and link.resolve() == Path(__file__).resolve():
            rows.append(("✓", "on PATH", str(link)))
        else:
            degraded = True
            rows.append(("⚠", "on PATH", f"{link} does not point here"))
            rows.append((" ", "  fix", f"ln -sf {Path(__file__).resolve()} {link}"))
    except OSError:
        degraded = True
        rows.append(("⚠", "on PATH", f"could not resolve {link}"))

    # 11. optional live probe — the only network path in the CLI. It probes
    #     the substrate itself, not the presence of a router: a machine with no
    #     bin/ still has a running server, and a probe that only works when a
    #     shell script happens to be installed probes nothing.
    probe = []
    if args.probe:
        import urllib.request
        for script, (url, label) in PROBES.items():
            try:
                with urllib.request.urlopen(url, timeout=3) as resp:
                    probe.append(("✓", label, f"reachable ({resp.status})"))
            except Exception as exc:
                probe.append(("⚠", label, f"unreachable — {type(exc).__name__}"))
                degraded = True

    # 12. the chat prompt — where the live one comes from, and whether it
    #     can be read as written. The editable copy shadows the card while it
    #     exists, so the check says which of the two the model is being
    #     given, and a broken tools section is a problem, not a shrug.
    try:
        import harness
    except Exception as exc:
        problems = True
        rows.append(("✗", "chat prompt", f"cannot load: {exc}"))
    else:
        try:
            source = harness.prompt_source()
            live = harness.system_prompt()
            tools = harness.tool_specs()
            rows.append(("✓", "chat prompt",
                         f"{source} — {len(live)} chars, {len(tools)} tool(s)"))
            # The prompt carries the primary signs. If the engine has moved
            # on and the live prompt has not, that is drift, not a style
            # difference — the same rule the views live under.
            missing = harness.missing_grounding(live)
            if missing:
                problems = True
                rows.append(("✗", "grounding",
                             "the live prompt does not carry the engine's "
                             + ", ".join(missing)))
                rows.append((" ", "  fix", "genesis prompt --write"))
        except harness.PromptError as exc:
            problems = True
            rows.append(("✗", "chat prompt", str(exc)))

    if problems:
        verdict = "PROBLEMS FOUND"
    elif degraded:
        verdict = "degraded"
    else:
        verdict = "healthy"

    emit(views.check(ctx.style, rows, verdict, probe))
    return 1 if problems else 0


def cmd_playlist(args, ctx):
    """The prompt for the new playlist — and its length against the budget."""
    try:
        import playlist
    except Exception as exc:
        die(f"cannot load the playlist module: {exc}")
    if args.check:
        n = playlist.length()
        if not playlist.within_budget():
            emit(f"✗ prompt is {n} chars — over the {playlist.LIMIT} budget")
            return 1
        emit(f"✓ prompt is {n}/{playlist.LIMIT} chars")
        return 0
    emit(views.playlist(ctx.style, playlist.render_parts()))
    return 0


def cmd_convergence(args, ctx):
    """The multiversal convergence matrix — the master equation, computed."""
    try:
        import convergence
    except Exception as exc:
        die(f"cannot load the convergence module: {exc}")
    if args.density:
        num, den, ratio = convergence.density_by_position()
        n2, d2, r2, dupes = convergence.density_by_distinct_track()
        emit(f"by position       {num}/{den} = {ratio:.4f}")
        emit(f"by distinct track {n2}/{d2} = {r2:.4f}")
        if dupes:
            emit("repeated: " + ", ".join(dupes))
        return 0
    header = [
        ("operator", "Zachary Maatariki Snushall"),
        ("temporal anchor", "W = [{0}, {1}]".format(*convergence.TEMPORAL_ANCHOR)),
        ("core signal", ", ".join(convergence.CORE_SIGNAL_TRACKS)),
    ]
    emit(views.document(ctx.style, "CONVERGENCE",
                         "the multiversal convergence matrix",
                         header, convergence.render_parts()))
    return 0


def cmd_handoff(args, ctx):
    """Print a handoff document. `genesis handoff gemini` for the named one."""
    known = {"gemini": "HANDOFF-GEMINI.md"}
    if not args.name or args.name.lower() in ("list", "?"):
        emit(views.handoffs(ctx.style,
                              {n: docs_relative(f) for n, f in known.items()}))
        return 0
    name = args.name.lower()
    f = DOCS / known.get(name, f"HANDOFF-{name.upper()}.md")
    if not f.exists():
