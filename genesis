def _open_codexify(with_ui: bool):
    """Open Codexify in the default browser, once it is up.

    The wizard's last act: the stack was just proven by a probe that got
    an answer, so opening is honest. The interface is opened with
    `--with-ui`; the backend is what a run without it serves. A machine
    with no opener — no `open`, no `xdg-open` — is told the URL instead
    of silently getting nothing.
    """
    url = ("http://127.0.0.1:5173" if with_ui
           else "http://127.0.0.1:8888")
    if os.environ.get("GENESIS_NO_BROWSER"):
        print(f"  it is running at {url} — the browser is not opened "
              "(GENESIS_NO_BROWSER is set).")
        return
    # A run with no terminal on it is not a person: a test harness, an
    # agent's shell, a pipeline. Opening a browser from one of those
    # puts a window on someone's desk that they did not ask for. A
    # person in a terminal gets the window; GENESIS_OPEN_BROWSER=1 says
    # so explicitly for the run that is not one.
    if not os.environ.get("GENESIS_OPEN_BROWSER"):
        try:
            on_a_terminal = sys.stdout.isatty()
        except (AttributeError, ValueError):
            on_a_terminal = False
        if not on_a_terminal:
            print(f"  it is running at {url} — the browser is not opened "
                  "(this run is not on a terminal).")
            return
    opener = shutil.which("open") or shutil.which("xdg-open")
    if not opener:
        print(f"  it is running at {url} — open that in a browser.")
        return
    try:
        subprocess.Popen([opener, url], stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL)
        print(f"  opened {url}")
    except OSError as exc:
        print(f"  it is running at {url} — the browser could not be "
              f"opened: {exc}")


def _codexify_wizard(args, ctx, codexify, explicit):
    """The continuous wizard: nothing → code → stack → launcher → done.

    One loop, and each pass does the next thing the machine is missing:

    1. no installation → install the code (streamed, every line shown)
    2. no `.env` or dead stack → run setup (streamed)
    3. stack answering → make the launcher, and finish

    A phase that fails is named in plain steps, and the wizard asks —
    in a terminal — whether to retry after the operator has fixed it.
    It exits when the machine is done, when a retry is declined, or
    after a phase fails twice the same way; it never exits silently in
    the middle of a machine that is not finished.
    """
    import codexify_install
    import codexify_native

    print("  the wizard — from nothing to a running stack\n")
    last_failures = None
    for _ in range(8):
        install = codexify.find_install(ROOT, explicit)

        # -- phase 1: the code ------------------------------------------------
        if install is None:
            print("\n  phase 1 — the code\n")
            report = codexify_install.install(ROOT, explicit=explicit,
                                             stream=True)
            _emit_codexify_report(ctx, report)
            if report.exit_code != codexify.EXIT_OK:
                if not _wizard_retry(report):
                    return report.exit_code
                continue
            install = codexify.find_install(ROOT, explicit)
            if install is None:
                print("  the install reported success but there is still "
                      "no installation — stopping rather than looping.")
                return codexify.EXIT_MISSING_INSTALL

        # -- phase 2: the stack ----------------------------------------------
        # A --theme is a configuration change, not a missing piece: the
        # stack may be fully up, but its .env does not carry this theme,
        # so the setup pass must run anyway to write it and restart the
        # interface under it.
        theme_pending = getattr(args, "theme", None) is not None
        if (theme_pending
                or not codexify.is_setup_done(
                    install, want_ui=_codexify_wants_ui(args))):
            print("\n  phase 2 — provisioning and starting the stack\n")
            launcher = getattr(args, "launcher", None)
            if (launcher is None
                    and not getattr(args, "no_launcher", False)):
                launcher = "desktop"
            with_ui = _codexify_wants_ui(args)
            report = codexify_native.setup(
                install, explicit=explicit,
                python=getattr(args, "python", None),
                preset=getattr(args, "preset", None),
                model=getattr(args, "model", None),
                cloud=bool(getattr(args, "allow_cloud", False)),
                with_ui=with_ui,
                dry_run=bool(getattr(args, "dry_run", False)),
                launcher=launcher,
                theme=getattr(args, "theme", None),
                stream=True)
            _emit_codexify_report(ctx, report)
            if report.exit_code != codexify.EXIT_OK:
                failures = _failed_steps(report)
                if failures == last_failures:
                    print("  the same steps failed twice — the wizard is "
                          "not going to fix them by running again.")
                    return report.exit_code
                last_failures = failures
                if not _wizard_retry(report):
                    return report.exit_code
                continue

            # -- phase 3: the launcher ---------------------------------------
            if launcher and not any(
                    row.label == "the launcher"
                    for row in report.rows):
                print("\n  phase 3 — the launcher\n")
                made, detail = codexify_native.make_launcher(
                    install, launcher)
                _emit_codexify_report(ctx, codexify.Report(
                    heading="CODEXIFY (launcher)",
                    rows=[codexify.Row("the launcher",
                                       codexify.OK if made
                                       else codexify.MANUAL, detail)],
                    verdict=("the launcher is on the "
                             + ("Desktop" if launcher == "desktop"
                                else "Applications folder")
                             if made else "the launcher was not made"),
                    exit_code=codexify.EXIT_OK))

        # -- done --------------------------------------------------------------
        print("\n  the wizard is finished — the stack is up.")
        _open_codexify(_codexify_wants_ui(args))
        return codexify.EXIT_OK

    print("  the wizard ran out of passes — something is not converging.")
    return codexify.EXIT_PARTIAL


def _failed_steps(report):
    """The failed rows, as instructions for a person to act on."""
    return [(row.label, row.detail) for row in report.rows
            if row.mark == "✗"]


def _wizard_retry(report):
    """A failed phase, and a person's decision about it.

    In a terminal the wizard asks: fix what the rows name and retry, or
    quit. Piped or flagged non-interactive, it runs once and exits with
    the honest code — a script driving the wizard gets the truth, not a
    hang on a prompt nobody can answer.
    """
    failed = _failed_steps(report)
    if not failed:
        return True
    print("\n  the wizard could not finish — these steps failed:")
    for label, detail in failed:
        print(f"  ✗ {label}: {detail}")
    if not sys.stdin.isatty() or getattr(_wizard_retry, "no_prompts", False):
        return False
    try:
        answer = input(
            "\n  fix what is named above and retry? [Y/n] ").strip().lower()
    except (EOFError, KeyboardInterrupt):
        return False
    return answer not in ("n", "no")


def cmd_codexify(args, ctx):
    """Provision the vendored Codexify install, and report what happened.

    The verbs: `status` reads, `setup` writes and starts, `down` stops,
    `install` gets the code, `update` moves it forward. Bare
    `genesis codexify` is the wizard: it walks the machine from nothing
    to a running stack with a launcher on the Desktop, printing
    everything as it goes, and it does not exit until the stack is up or
    a step refuses twice.

    The rule the rows obey: a row that reports a write says only what it
    wrote. Readiness is claimed by a row that made a request and got an
    answer, and by nothing else.
    """
    try:
        import codexify
    except Exception as exc:
        die(f"cannot load the codexify engine: {exc}")

    explicit = getattr(args, "codexify", None)
    install = codexify.find_install(ROOT, explicit)
    verb = getattr(args, "subcommand", None) or "status"

    # The wizard: bare `genesis codexify`, run repeatedly until the
    # machine is done or a step will not pass. Each pass checks what is
    # missing and does that phase — the code first, then the stack — so
    # the wizard converges from any starting state: an empty machine, a
    # half-configured one, or one that is already up.
    if verb in ("status", "install") and not explicit:
        want_wizard = (verb == "install"
                       or getattr(args, "wizard", False)
                       or install is None
                       or getattr(args, "theme", None) is not None
                       or not codexify.is_setup_done(
                           install, want_ui=_codexify_wants_ui(args)))
        if want_wizard:
            return _codexify_wizard(args, ctx, codexify, explicit)

    # install and update are about the code, not the run. They go before the
    # mode resolution — before the missing-install refusal — because
    # `install` is the one verb whose whole job is a machine that has no
    # installation for a mode to be resolved against.
    if verb in ("install", "update"):
        try:
            import codexify_install
        except Exception as exc:
            die(f"cannot load the install engine: {exc}")
        if verb == "install":
            report = codexify_install.install(
                ROOT, explicit=explicit, stream=True)
            _emit_codexify_report(ctx, report)
            return report.exit_code
        report = codexify_install.update(
            ROOT, explicit=explicit, stream=True)
        _emit_codexify_report(ctx, report)
        return report.exit_code

    try:
        mode = codexify.resolve_mode(
            install,
            docker=bool(getattr(args, "docker", False)),
            native=bool(getattr(args, "native", False)))
    except ValueError as exc:
        die(str(exc))

    if mode == codexify.MODE_NATIVE:
        try:
            import codexify_native
        except Exception as exc:
            die(f"cannot load the native codexify engine: {exc}")
        if verb == "setup":
            report = codexify_native.setup(
                install, explicit=explicit,
                python=getattr(args, "python", None),
                preset=getattr(args, "preset", None),
                model=getattr(args, "model", None),
                cloud=bool(getattr(args, "allow_cloud", False)),
                with_ui=_codexify_wants_ui(args),
                dry_run=bool(getattr(args, "dry_run", False)),
                launcher=getattr(args, "launcher", None),
            )
        elif verb == "down":
            report = codexify_native.down(install, explicit=explicit)
        else:
            report = codexify_native.status(install, explicit=explicit)
        rows = [(row.label, row.mark, row.detail) for row in report.rows]
        emit(views.codexify_report(ctx.style, report.heading, rows,
                                    report.verdict, report.exit_code))
        return report.exit_code

    provider_key = None
    if verb == "setup":
        wants_key = (getattr(args, "with_provider_key", False)
                     or getattr(args, "replace_key", False))
        if wants_key and not getattr(args, "dry_run", False):
            key, error = codexify.collect_provider_key(
                key_file=getattr(args, "key_file", None),
                provider=getattr(args, "provider", None))
            if error:
                # The key did not authenticate. That is a refusal, and a
                # refusal writes nothing.
                die(error, codexify.EXIT_KEY_REJECTED)
            provider_key = key
        services = None
        if getattr(args, "services", None):
            services = args.services.split()
        report = codexify.setup(
            install, explicit=explicit,
            preset=getattr(args, "preset", None),
            model=getattr(args, "model", None),
            cloud=bool(getattr(args, "allow_cloud", False)),
            up=not getattr(args, "no_up", False),
            build=not getattr(args, "no_build", False),
            dry_run=bool(getattr(args, "dry_run", False)),
            profiles=getattr(args, "profile", []) or [],
            services=services,
            timeout=float(getattr(args, "timeout", 900.0)),
            provider_key=provider_key,
        )
    elif verb == "down":
        report = codexify.down(
            install, explicit=explicit,
            volumes=bool(getattr(args, "volumes", False)),
        )
    else:
        report = codexify.status(install, explicit=explicit)

    rows = [(row.label, row.mark, row.detail) for row in report.rows]
    emit(views.codexify_report(ctx.style, report.heading, rows, report.verdict,
                                report.exit_code))
    return report.exit_code


