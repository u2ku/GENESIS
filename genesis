def cmd_symbols(args, ctx):
    blocks = load_blocks()
    names = [n for n in blocks if n != "id"]

    if args.list:
        emit("symbol blocks:")
        for n in names:
            emit(f"  {n}")
        return 0

    if args.all:
        emit(views.symbols_dump(ctx.style, blocks))
        return 0

    if args.copy:
        if not args.name:
            die("--copy needs a block name (see genesis symbols)")
        if args.name not in blocks:
            die(f"unknown block: {args.name}")
        to_clipboard(blocks[args.name])
        emit(f"copied: {args.name}")
        return 0

    if not args.name:
        emit(views.symbols_index(ctx.style, blocks))
        return 0

    if args.name not in blocks:
        die(f"unknown block: {args.name}")
    emit(blocks[args.name])
    return 0


