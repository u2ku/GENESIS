def cmd_landing(args, ctx):
    """Prepare a node as a host, and set this machine up as one.

    Landing is the trigger for the whole node setup: Tailscale, the
    tailnet, the heartbeat daemon, and the node's own report to the
    spine. The key is the wizard's business — it is asked for once and
    stored once — so landing never prompts for it.

    `--readiness-only` (the old `--no-join`) reports readiness and changes
    nothing on this machine. That is the mode the bootstrap's own
    readiness probe uses, and the mode to use when the only question is
    whether a machine is ready.
    """
    if not args.node:
        die("landing needs a path to the node")
    node = Path(args.node).expanduser()
    if not node.exists():
        die(f"{node} does not exist")
    try:
        import harness
    except Exception as exc:
        die(f"cannot load the harness: {exc}")
    checks = harness.landing_checks(node)
    ready = all(good for _, good in checks)
    emit(views.landing_node(ctx.style, str(node), checks, ready,
                             harness.LANDING_NOTE))
    if getattr(args, "readiness_only", False):
        return 0 if ready else 1
    outcome = harness.landing_setup(node, join=True)
    emit(views.landing_setup(ctx.style, outcome.get("rows") or []))
    return int(outcome.get("exit") or 0)


