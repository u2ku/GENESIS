        return sorted(codexify.PRESETS)
    except Exception:
        return ["ollama", "whooshd-mlx"]


def codexify_profiles():
    """The optional compose profiles."""
    try:
        import codexify
        return list(codexify.PROFILES)
    except Exception:
        return ["backfill", "cli", "voice"]


