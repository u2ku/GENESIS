def cmd_check(probe: bool):
    ok = True
    warned = False
    print("GENESIS check")
    print()

    # 1. the pinned identity, and the engine's agreement with it
    try:
        import grammar
    except Exception as exc:
        print(f"  ✗ grammar.py     cannot load: {exc}")
        grammar = None
        ok = False
    if grammar is not None:
        if not IDENTITY_FILE.exists():
            print(f"  ✗ identity.g     missing")
            ok = False
        else:
            raw = IDENTITY_FILE.read_text(encoding="utf-8").strip()
            if not raw:
                print(f"  ✗ identity.g     empty")
                ok = False
            elif raw != grammar.ID:
                print(f"  ✗ constant       identity.g and the engine disagree")
                print(f"    {'':16} file    {raw!r}")
                print(f"    {'':16} engine {grammar.ID!r}")
                ok = False
            else:
                print(f"  ✓ constant       {raw}")

    blocks = load_blocks()

    # 2. the human view agrees with the pinned identity
    if not IDENTITY_MD.exists():
        print(f"  ✗ IDENTITY.md    missing")
        ok = False
    elif PINNED_ID not in IDENTITY_MD.read_text(encoding="utf-8"):
        print(f"  ✗ IDENTITY.md    does not carry the constant — view has drifted")
        ok = False
    else:
        print(f"  ✓ IDENTITY.md    view carries the constant")

    # 3. the prediction view agrees with the engine's arc
    seq = blocks.get("arc", "")
    pred = DOCS / "PREDICTION.md"
    if not pred.exists():
        print(f"  ✗ PREDICTION.md  missing")
        ok = False
    elif seq and seq not in pred.read_text(encoding="utf-8"):
        print(f"  ✗ PREDICTION.md  does not carry the sequence — view has drifted")
        ok = False
    else:
        print(f"  ✓ PREDICTION.md  view carries the sequence")

    # 5. the singularity view agrees with the engine's gap
    sing = DOCS / "SINGULARITY.md"
    gap = blocks.get("gap", "")
    if not sing.exists():
        print(f"  ✗ SINGULARITY.md missing")
        ok = False
    elif gap and gap not in sing.read_text(encoding="utf-8"):
        print(f"  ✗ SINGULARITY.md does not carry the gap — view has drifted")
        ok = False
    else:
        print(f"  ✓ SINGULARITY.md view carries the gap")

    # 6. guard rail — the subset relation may never be asserted
    if cmd_guardrail([]) != 0:
        ok = False

    # 7. bin/ integrity — the routers are borrowed infrastructure, not part of
    #    the identity system; verify they are intact, but do not surface them.
    routers = sorted(p for p in BIN.glob("*") if p.is_file() and not p.name.startswith("."))
    broken = []
    for p in routers:
        if not os.access(p, os.X_OK):
            broken.append(f"{p.name} not executable")
            continue
        if subprocess.run(["bash", "-n", str(p)], capture_output=True).returncode != 0:
            broken.append(f"{p.name} syntax error")
    if not routers:
        print(f"  ✗ bin/           empty")
        ok = False
    elif broken:
        print(f"  ✗ bin/           {len(routers)} routers, {len(broken)} broken")
        for b in broken:
            print(f"  {'':16} {b}")
        ok = False
    else:
        print(f"  ✓ bin/           {len(routers)} routers intact")

    # 7. on PATH
    link = Path.home() / ".local" / "bin" / "genesis"
    try:
        if link.exists() and link.resolve() == Path(__file__).resolve():
            print(f"  ✓ on PATH        {link}")
        else:
            warned = True
            print(f"  ⚠ on PATH        {link} does not point here")
            print(f"  {'':16} fix: ln -sf {Path(__file__).resolve()} {link}")
    except OSError:
        warned = True
        print(f"  ⚠ on PATH        could not resolve {link}")

    # 6. optional live probe
    if probe:
        print()
        print("  live probe")
        import urllib.request
        for script, (url, label) in PROBES.items():
            if script not in {p.name for p in routers}:
                continue
            try:
                with urllib.request.urlopen(url, timeout=3) as resp:
                    print(f"  ✓ {label:<16} reachable ({resp.status})")
            except Exception as exc:
                print(f"  ⚠ {label:<16} unreachable — {type(exc).__name__}")

    print()
    if not ok:
        print("PROBLEMS FOUND")
    elif warned:
        print("healthy (with warnings)")
    else:
        print("healthy")
    return 0 if ok else 1


