def cmd_prompt(args, ctx):
    """The chat prompt — everything the model is given, before the
    conversation starts.

    `genesis prompt` prints the live copy. `genesis prompt --write` writes
    it, and that copy is what the model is given from then on until --reset
    takes it away. Edit it in any text editor and save: the next turn uses
    it.
    """
    try:
        import harness
    except Exception as exc:
        die(f"cannot load the harness: {exc}")

    if args.write:
        had_one = harness.PROMPT_DEBUG.exists()
        path = harness.write_debug_prompt()
        size = len(path.read_text(encoding="utf-8"))
        emit(f"wrote {path.relative_to(ROOT).as_posix()} — {size} chars — "
             f"it is the live prompt now")
        if had_one:
            backup = path.with_name(path.name + ".bak")
            emit(f"the copy that was there is kept as "
                 f"{backup.relative_to(ROOT).as_posix()}")
        return 0

    if args.reset:
        if harness.reset_debug_prompt():
            emit("the editable copy is gone — the prompt is the card again.")
        else:
            emit("there was no editable copy.")
        return 0

    if args.source:
        emit("live: " + harness.prompt_source())
        return 0

    if args.tools:
        try:
            specs = harness.tool_specs()
        except harness.PromptError as exc:
            die(str(exc))
        emit(json.dumps(specs, indent=2, ensure_ascii=False))
        return 0

    if args.system:
        emit(harness.system_prompt())
        return 0

    if harness.PROMPT_DEBUG.exists():
        emit(harness.PROMPT_DEBUG.read_text(encoding="utf-8"))
        return 0
    emit(harness.system_prompt() + "\n" + harness.base_tools())
    return 0


