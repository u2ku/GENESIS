def cmd_numergram(argv):
    """Append in the same grammar, keeping the original spine byte-intact."""
    blocks = load_blocks()
    spine = blocks.get("numergram", "")
    if not spine:
        die("no @numergram spine in identity.g")
    terminal = "—　—　—　⊙"

    if "--check" in argv:
        i = argv.index("--check")
        cand = argv[i + 1] if i + 1 < len(argv) else ""
        ok = True
        if not cand.startswith(spine):
            print("✗ spine not byte-intact — the original must lead, unchanged")
            ok = False
        else:
            print("✓ spine byte-intact")
        allowed = set(blocks.get("glyphs", "").replace(" ", ""))
        allowed |= set(spine) | set("·—|+=()")
        extra = {c for c in cand if c not in allowed and c not in "　 \n"}
        if extra:
            print("✗ outside the vocabulary: " + " ".join(sorted(extra)))
            ok = False
        else:
            print("✓ vocabulary respected")
        return 0 if ok else 1

    if "--append" in argv:
        i = argv.index("--append")
        frag = argv[i + 1] if i + 1 < len(argv) else ""
        if not frag.strip():
            die("--append needs a symbolic fragment")
        out = spine + "\n\n" + frag + "\n\n" + terminal
        print(out)
        return 0

    print(spine)
    return 0


