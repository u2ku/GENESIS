# --- GENESIS repo scaffolding (2026-11-13) ---
# Live env / secrets — never commit
.env
.env.*
*.local
!.env.example

# Local model wrappers — not published (Zac's call, 2026-11-13)
bin/

# Private operational handoff copy — the scrubbed-out block from
# docs/HANDOFF-GEMINI.md lives here and must never enter git history.
# Listed explicitly because the `*.local` pattern above does not match
# a `*.local.md` filename.
docs/HANDOFF-GEMINI-private.local.md
# Belt-and-braces: any *.local.md stays out of git history, so a renamed
# or copied private handoff cannot be staged and shipped by accident.
*.local.md

# Local state / caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.log
logs/
state/
# The copy of the chat prompt that a regenerate replaced. It holds edits
# that were live a moment ago; it is a working note, not a source.
prompt.debug.md.bak
# Runtime state dropped into the working tree by tools that happen to run
# here: a sync database, a memory store, a plugin manifest. Nothing in the
# repo references them, and a published tree should not carry them.
# Root-anchored, so nothing nested is hidden by them.
/guardian.db
/guardian/
/plugins/
.DS_Store
